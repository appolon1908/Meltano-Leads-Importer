{
  "schema_version": "1.1",
  "owner": "Meltano-Leads-Importer",
  "input": [
    "csv",
    "json",
    "jsonl",
    "xlsx via preprocessing",
    "api",
    "database"
  ],
  "output": {
    "database": "leads_workstation",
    "schema": "lead_import_raw",
    "tables": {
      "batches": "import_batches",
      "records": "records"
    },
    "required_metadata": [
      "import_batch_id",
      "source_name",
      "source_path",
      "source_row",
      "ingested_at",
      "source_sha256",
      "source_fingerprint"
    ]
  },
  "local_certification": {
    "sqlite_mirror": "runtime/raw-staging.db",
    "canonical_authority": false
  },
  "promotion": {
    "authority": "Leads-Workstation API",
    "endpoint": "POST /api/leads",
    "direct_to_canonical_forbidden": true
  },
  "safety": {
    "allowed_database_schema": "lead_import_raw",
    "canonical_database_write": "forbidden",
    "raw_payload_in_public_git": "forbidden"
  },
  "downstream": {
    "n8n_trigger": "accepted lead / import-completed event after promotion",
    "n8n_direct_db_write_forbidden": true
  }
}
